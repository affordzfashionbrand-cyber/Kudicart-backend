# ==========================================
# KudiCart Backend Production Environment Variables
# Copy to .env.production and populate before deployment
# ==========================================

APP_ENV=production
PORT=3001
JWT_SECRET="[REQUIRED_32_BYTE_RANDOM_SECRET]"
ORDER_OTP_SECRET="[REQUIRED_ORDER_OTP_SECRET]"

# Supabase Managed PostgreSQL with PGBouncer (Decision D-016)
# Note: prisma/schema.prisma reads DATABASE_URL directly (no DIRECT_URL).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Firebase Admin SDK (Decision D-017, D-018)
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"
# Alternative when mounting JSON directly instead of a file path:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Razorpay Production Payment Gateway (Decision D-020)
RAZORPAY_KEY_ID="rzp_live_[YOUR_LIVE_KEY_ID]"
RAZORPAY_KEY_SECRET="[YOUR_LIVE_KEY_SECRET]"
RAZORPAY_WEBHOOK_SECRET="[YOUR_LIVE_WEBHOOK_SECRET]"

# Redis / BullMQ Background Queues (Decision D-027)
REDIS_HOST="kudicart-cluster.[ID].cache.amazonaws.com"
REDIS_PORT=6379
REDIS_PASSWORD=""
# Alternative single-URL Redis configuration:
# REDIS_URL="rediss://:[PASSWORD]@[HOST]:6379"

# Google Maps Platform (Decision D-021)
GOOGLE_MAPS_ROUTES_API_KEY="AIzaSy[YOUR_RESTRICTED_ROUTES_KEY]"
# Fallback if GOOGLE_MAPS_ROUTES_API_KEY is not set:
# GOOGLE_MAPS_API_KEY="AIzaSy[YOUR_RESTRICTED_KEY]"

# Supabase Storage (Decision DCR-002 / DCR-015)
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]"

# Sentry Error Tracking (Decision D-023)
SENTRY_DSN="https://[KEY]@[ORG].ingest.sentry.io/[PROJECT_ID]"
SENTRY_TRACES_SAMPLE_RATE=0.1

# Security, Auth Flags & CORS Origins
ALLOWED_ORIGINS="https://affordz.com,https://admin.affordz.com,https://vendor.affordz.com"
# ENABLE_SWAGGER=false
# ALLOW_DEV_ADMIN_PASSWORD=false
# DISABLE_DEV_OTP=true
