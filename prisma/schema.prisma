datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  DRIVER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum FulfillmentType {
  DARK_STORE
  VENDOR
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id           String          @id @default(uuid())
  firebaseUid  String          @unique
  phone        String?         @unique
  email        String?         @unique
  name         String
  avatar       String?
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  addresses    Address[]
  carts        Cart[]
  orders       Order[]         @relation("CustomerOrders")
  driverOrders Order[]         @relation("DriverOrders")
  reviews      Review[]
  tickets      SupportTicket[]
  vendor       Vendor?
  driverProfile DriverProfile?
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  locality  String
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  countText String
  icon      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Vendor {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  storeName String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model DarkStoreHub {
  id              String          @id @default(uuid())
  name            String
  locality        String
  address         String
  lat             Float
  lng             Float
  deliveryMinutes Int             @default(18)
  isActive        Boolean         @default(true)
  products        Product[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Product {
  id                String          @id @default(uuid())
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  brand             String
  title             String
  description       String
  price             Float
  originalPrice     Float
  discount          String
  rating            Float           @default(4.5)
  reviewsCount      Int             @default(0)
  stockQuantity     Int             @default(10)
  stockBadge        String?
  readyToShip       Boolean         @default(true)
  sizes             String[]
  fabric            String?
  origin            String?
  image             String
  altText           String
  galleryImages     String[]
  fulfillmentType   FulfillmentType @default(VENDOR)
  darkStoreHubId    String?
  darkStoreHub      DarkStoreHub?   @relation(fields: [darkStoreHubId], references: [id])
  tryAndBuyEligible Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  reviews           Review[]
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float        @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int          @default(0)
  startDate     DateTime     @default(now())
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      String
  trialSize String?
  color     String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  customerId        String
  customer          User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId          String?
  driver            User?                @relation("DriverOrders", fields: [driverId], references: [id])
  addressId         String
  address           Address              @relation(fields: [addressId], references: [id])
  status            OrderStatus          @default(PLACED)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus        @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  itemTotal         Float
  deliveryFee       Float                @default(40.0)
  taxes             Float
  grandTotal        Float
  etaMinutes        Int                  @default(35)
  isTryAndBuy       Boolean              @default(false)
  couponCode        String?
  discountAmount    Float                @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  items             OrderItem[]
  history           OrderStatusHistory[]
  tickets           SupportTicket[]
  reviews           Review[]
  tryAndBuySession  TryAndBuySession?
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  title     String
  brand     String
  size      String
  trialSize String?
  price     Float
  quantity  Int
  image     String
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id])
  title     String
  category  String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model DriverProfile {
  id                  String           @id @default(uuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id])
  fullName            String
  phone               String
  aadhaarNumber       String?
  panNumber           String?
  dob                 String?
  licenseNumber       String?
  workPreference      String           @default("PART_TIME")
  tier                String           @default("Silver Tier")
  rating              Float            @default(4.9)
  completedDeliveries Int              @default(0)
  isOnline            Boolean          @default(false)
  kycStatus           String           @default("PENDING")
  rejectionReason     String?
  vehicleRegistration String?
  vehicleType         String?
  vehicleMake         String?
  vehicleModel        String?
  rcStatus            String           @default("Under review")
  rcNumber            String?
  selfieUrl           String?
  currentLat          Float?
  currentLng          Float?
  currentHeading      Float?
  documents           DriverDocument[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model DriverDocument {
  id              String        @id @default(uuid())
  driverId        String
  driver          DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type            String
  side            String
  fileName        String
  fileUrl         String
  fileSize        String?
  mimeType        String?
  status          String        @default("PENDING")
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
}

model DriverSlot {
  id          String              @id @default(uuid())
  dateKey     String
  timeRange   String
  demand      String              @default("Normal demand")
  bonusText   String?
  capacity    Int                 @default(5)
  isLocked    Boolean             @default(false)
  bookings    DriverSlotBooking[]
  createdAt   DateTime            @default(now())
}

model DriverSlotBooking {
  id        String     @id @default(uuid())
  slotId    String
  slot      DriverSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  driverId  String
  status    String     @default("BOOKED")
  bookedAt  DateTime   @default(now())

  @@unique([slotId, driverId])
}

model DriverNotification {
  id          String   @id @default(uuid())
  driverId    String
  category    String
  title       String
  body        String
  read        Boolean  @default(false)
  amount      String?
  actionRoute String?
  actionLabel String?
  createdAt   DateTime @default(now())
}

model TryAndBuySession {
  id                         String    @id @default(uuid())
  orderId                    String    @unique
  order                      Order     @relation(fields: [orderId], references: [id])
  driverId                   String
  stage                      String    @default("HANDOVER_PENDING")
  trialDurationMinutes       Int       @default(20)
  handoverConfirmedAt        DateTime?
  trialStartedAt             DateTime?
  trialEndsAt                DateTime?
  finalPayableTotal          Float?
  refundAmount               Float?
  amountDue                  Float?
  paymentStatus              String?
  returnManifestId           String?
  storeReconciliationStatus String?
  storeReconciledAt          DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}
