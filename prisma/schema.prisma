datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  DRIVER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNING
  RETURNED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FulfillmentType {
  DARK_STORE
  VENDOR
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id           String          @id @default(uuid())
  firebaseUid  String          @unique
  phone        String?         @unique
  email        String?         @unique
  name         String
  avatar       String?
  role         Role            @default(CUSTOMER)
  status       UserStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  addresses       Address[]
  carts           Cart[]
  checkoutGroups  CheckoutGroup[]
  orders          Order[]          @relation("CustomerOrders")
  driverOrders    Order[]          @relation("DriverOrders")
  reviews         Review[]
  tickets         SupportTicket[]
  vendor          Vendor?
  driverProfile   DriverProfile?
  deviceTokens    DeviceToken[]
  notifications   Notification[]
  idempotencyKeys IdempotencyKey[]
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  recipientName  String?
  recipientPhone String?
  line1          String
  line2          String?
  locality       String
  city           String
  state          String?
  pincode        String   @default("560038")
  latitude       Float?
  longitude      Float?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model Category {
  id           String     @id @default(uuid())
  code         String?    @unique
  name         String
  slug         String?    @unique
  description  String?
  level        Int        @default(1) // 1: Main Category, 2: SubCategory, 3: SubSubCategory
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[] @relation("CategoryHierarchy")
  countText    String?
  icon         String?
  image        String?
  banner       String?
  gender       String?    // 'Women' | 'Men' | 'Kids' | 'Unisex'
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  isPopular    Boolean    @default(false)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([level])
  @@index([gender])
}

model Vendor {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  storeName       String
  commissionRate  Float          @default(12.5)
  status          String         @default("ACTIVE")
  address         String?
  phone           String?
  contactPerson   String?
  latitude        Float?
  longitude       Float?
  operatingHub    String?
  category        String?
  rejectionReason String?
  products        Product[]
  orders          Order[]        @relation("VendorOrders")
  ledgerEntries   LedgerEntry[]
  payouts         VendorPayout[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model DarkStoreHub {
  id              String          @id @default(uuid())
  name            String
  locality        String
  address         String
  lat             Float
  lng             Float
  deliveryMinutes Int             @default(18)
  isActive        Boolean         @default(true)
  products        Product[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Product {
  id                String          @id @default(uuid())
  sku               String?
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  brand             String
  title             String
  description       String
  price             Float
  originalPrice     Float
  discount          String
  rating            Float           @default(4.5)
  reviewsCount      Int             @default(0)
  stockQuantity     Int             @default(10)
  stockBadge        String?
  listingStatus     String          @default("ACTIVE")
  gender            String?
  tags              String[]        @default([])
  readyToShip       Boolean         @default(true)
  sizes             String[]
  fabric            String?
  origin            String?
  image             String
  altText           String
  galleryImages     String[]
  fulfillmentType   FulfillmentType @default(VENDOR)
  darkStoreHubId    String?
  darkStoreHub      DarkStoreHub?   @relation(fields: [darkStoreHubId], references: [id])
  tryAndBuyEligible Boolean         @default(false)
  colors            Json?
  colorGroupId      String?
  colorName         String?
  colorHex          String?
  specifications    Json?
  certification     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  reviews           Review[]
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float        @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int          @default(0)
  startDate     DateTime     @default(now())
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Cart {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode     String?
  giftWrap       Boolean    @default(false)
  donationAmount Float      @default(0)
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      String
  trialSize String?
  color     String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckoutGroup {
  id                String               @id @default(uuid())
  groupNumber       String               @unique
  customerId        String
  customer          User                 @relation(fields: [customerId], references: [id])
  addressId         String?
  deliveryAddress   Json?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus        @default(PENDING)
  razorpayOrderId   String?              @unique
  razorpayPaymentId String?
  couponCode        String?
  itemTotal         Float
  discountTotal     Float                @default(0)
  giftWrapFee       Float                @default(0)
  donationAmount    Float                @default(0)
  deliveryFeeTotal  Float                @default(0)
  taxesTotal        Float                @default(0)
  grandTotal        Float
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  orders            Order[]
  transactions      PaymentTransaction[]

  @@index([customerId])
  @@index([paymentStatus, expiresAt])
}

model Order {
  id                 String               @id @default(uuid())
  orderNumber        String               @unique
  version            Int                  @default(1)
  checkoutGroupId    String?
  checkoutGroup      CheckoutGroup?       @relation(fields: [checkoutGroupId], references: [id], onDelete: SetNull)
  customerId         String
  customer           User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  vendorId           String?
  vendor             Vendor?              @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: SetNull)
  driverId           String?
  driver             User?                @relation("DriverOrders", fields: [driverId], references: [id])
  driverProfileId    String?
  driverProfile      DriverProfile?       @relation("DriverProfileOrders", fields: [driverProfileId], references: [id], onDelete: SetNull)
  addressId          String?
  address            Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  deliveryAddress    Json?
  fulfillmentType    FulfillmentType      @default(DARK_STORE)
  status             OrderStatus          @default(PLACED)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus        @default(PENDING)
  razorpayOrderId    String?
  razorpayPaymentId  String?
  itemTotal          Float
  deliveryFee        Float                @default(40.0)
  taxes              Float
  giftWrapFee        Float                @default(0)
  donationAmount     Float                @default(0)
  grandTotal         Float
  etaMinutes         Int                  @default(35)
  isTryAndBuy        Boolean              @default(false)
  couponCode           String?
  discountAmount       Float                @default(0)
  deliveryInstructions String?
  verificationPhotos   String[]             @default([])
  deliveryOtpHash      String?
  arrivedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  rejectedByVendor   Boolean              @default(false)
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items              OrderItem[]
  history            OrderStatusHistory[]
  tickets            SupportTicket[]
  reviews            Review[]
  tryAndBuySession   TryAndBuySession?
  transactions       PaymentTransaction[]
  ledgerEntries      LedgerEntry[]
  dispatchAssignment DispatchAssignment?

  @@index([checkoutGroupId])
  @@index([customerId])
  @@index([vendorId])
  @@index([driverId])
  @@index([driverProfileId])
  @@index([status])
  @@index([paymentStatus, expiresAt])
  @@index([createdAt])
}

model OrderItem {
  id                String    @id @default(uuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  title             String
  brand             String
  size              String
  trialSize         String?
  price             Float
  quantity          Int
  image             String
  tryAndBuyDecision String?
  returnCondition   String?
  collectedAt       DateTime?
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actorRole String?
  createdAt DateTime    @default(now())
}

model SupportTicket {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id])
  title             String
  description       String              @default("")
  category          String
  priority          String              @default("MEDIUM")
  status            SupportTicketStatus @default(OPEN)
  assignee          String?
  resolutionRemarks String?
  resolvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  rating     Int
  comment    String
  status     String   @default("PUBLISHED")
  flagReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
}

model DriverProfile {
  id                  String           @id @default(uuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id])
  fullName            String
  phone               String
  aadhaarNumber       String?
  panNumber           String?
  dob                 String?
  licenseNumber       String?
  workPreference      String           @default("PART_TIME")
  tier                String           @default("Silver Tier")
  rating              Float            @default(4.9)
  completedDeliveries Int              @default(0)
  isOnline            Boolean          @default(false)
  availableSince      DateTime?
  kycStatus           String           @default("PENDING")
  rejectionReason     String?
  vehicleRegistration String?
  vehicleType         String?
  vehicleMake         String?
  vehicleModel        String?
  rcStatus            String           @default("Under review")
  rcNumber            String?
  selfieUrl           String?
  currentLat          Float?
  currentLng          Float?
  currentHeading      Float?
  documents           DriverDocument[]
  orders              Order[]              @relation("DriverProfileOrders")
  tryAndBuySessions   TryAndBuySession[]   @relation("DriverProfileTryAndBuySessions")
  dispatchAssignments DispatchAssignment[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([isOnline, kycStatus, availableSince])
}

model DriverDocument {
  id              String        @id @default(uuid())
  driverId        String
  driver          DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type            String
  side            String
  fileName        String
  fileUrl         String
  fileSize        String?
  mimeType        String?
  status          String        @default("PENDING")
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
}

model DriverSlot {
  id          String              @id @default(uuid())
  dateKey     String
  timeRange   String
  demand      String              @default("Normal demand")
  bonusText   String?
  capacity    Int                 @default(5)
  isLocked    Boolean             @default(false)
  bookings    DriverSlotBooking[]
  createdAt   DateTime            @default(now())
}

model DriverSlotBooking {
  id        String     @id @default(uuid())
  slotId    String
  slot      DriverSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  driverId  String
  status    String     @default("BOOKED")
  bookedAt  DateTime   @default(now())

  @@unique([slotId, driverId])
}

model DriverNotification {
  id          String   @id @default(uuid())
  driverId    String
  category    String
  title       String
  body        String
  read        Boolean  @default(false)
  amount      String?
  actionRoute String?
  actionLabel String?
  createdAt   DateTime @default(now())
}

model TryAndBuySession {
  id                         String         @id @default(uuid())
  orderId                    String         @unique
  order                      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId                   String?
  driverProfileId            String?
  driverProfile              DriverProfile? @relation("DriverProfileTryAndBuySessions", fields: [driverProfileId], references: [id], onDelete: SetNull)
  stage                      String         @default("HANDOVER_PENDING")
  trialDurationMinutes       Int            @default(10)
  handoverConfirmedAt        DateTime?
  trialStartedAt             DateTime?
  trialEndsAt                DateTime?
  finalPayableTotal          Float?
  refundAmount               Float?
  amountDue                  Float?
  paymentStatus              String?
  returnManifestId           String?
  keptItemIds               String[]       @default([])
  returnedItemIds           String[]       @default([])
  handoverImages            String[]       @default([])
  returnImages              String[]       @default([])
  customerSelectionAt       DateTime?
  storeReconciliationStatus String?
  storeReconciledAt         DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([driverProfileId])
  @@index([stage])
}

model DispatchAssignment {
  id              String         @id @default(uuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverProfileId String?
  driverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)
  status          String         @default("PENDING") // PENDING, OFFERED, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  offeredAt       DateTime?
  expiresAt       DateTime?
  respondedAt     DateTime?
  attempts        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([driverProfileId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model PaymentTransaction {
  id              String         @id @default(uuid())
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkoutGroupId String?
  checkoutGroup   CheckoutGroup? @relation(fields: [checkoutGroupId], references: [id], onDelete: Cascade)
  paymentId       String
  refundId        String?        @unique
  transactionType String         @default("CAPTURE")
  razorpayOrderId String?
  signature       String?
  amount          Float
  currency        String         @default("INR")
  status          String
  method          String?
  eventId         String?        @unique
  failureReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([paymentId])
  @@index([checkoutGroupId])
  @@index([orderId])
}

model LedgerEntry {
  id           String   @id @default(uuid())
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vendorId     String?
  vendor       Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  driverId     String?
  entryType    String
  amount       Float
  description  String
  balanceAfter Float?
  createdAt    DateTime @default(now())
}

model VendorPayout {
  id           String   @id @default(uuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount       Float
  status       String   @default("PENDING")
  referenceId  String?
  payoutMethod String?  @default("BANK_TRANSFER")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role
  platform   String   // android | ios | web
  token      String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, role])
  @@index([token])
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       // ORDER | DISPATCH | TRY_AND_BUY | PAYMENT
  aggregateId   String
  eventType     String       // e.g. ORDER_STATUS_CHANGED, DRIVER_ASSIGNED
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope        String
  key          String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String   @default("RAZORPAY")
  eventId         String   @unique
  eventType       String
  payloadHash     String
  orderId         String?
  checkoutGroupId String?
  processedAt     DateTime @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?
  orderId   String?
  category  String    @default("ORDER")
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead, createdAt])
  @@index([role, createdAt])
}

model DriverShift {
  id           String   @id @default(uuid())
  dayOfWeek    Int
  day          String
  dateStr      String
  timeRange    String
  duration     String
  hub          String
  hubAddress   String   @default("")
  status       String   @default("CONFIRMED")
  statusLabel  String
  breakTime    String?
  attendance   String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DriverSurge {
  id          String   @id @default(uuid())
  title       String
  area        String
  timeWindow  String
  bonusAmount Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkspaceSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
